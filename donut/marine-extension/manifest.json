{
  "manifest_version": 3,
  "name": "Marine 字幕 & 文本提取器",
  "version": "0.1.33",
  "description": "提取页面正文、字幕与评论，并为 Bilibili、知乎、小红书建立精确直评/回复目标。",
  "key": "",
  "minimum_chrome_version": "114",
  "permissions": [
    "storage",
    "downloads",
    "sidePanel",
    "scripting",
    "dom",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Marine — 抓取与话术（侧边栏）",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "src/sw-entry-0.1.33.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.bilibili.com/*"
      ],
      "js": [
        "src/publish-receipt.js",
        "src/publish-bridge.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": true
    },
    {
      "js": [
        "src/publish-receipt.js",
        "src/publish-bridge.js"
      ],
      "matches": [
        "*://*.zhihu.com/*",
        "*://*.xiaohongshu.com/*",
        "*://*.douyin.com/*"
      ],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": false
    },
    {
      "matches": [
        "*://*.bilibili.com/*"
      ],
      "js": [
        "src/content-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "exclude_matches": [
        "*://*.bilibili.com/*"
      ],
      "js": [
        "src/content-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.youtu.be/*",
        "*://*.bilibili.com/*",
        "*://*.zhihu.com/*",
        "*://*.xiaohongshu.com/*",
        "*://*.xhslink.com/*",
        "*://*.douyin.com/*"
      ],
      "js": [
        "src/platforms/youtube.js",
        "src/platforms/bilibili.js",
        "src/platforms/discovery.js",
        "src/platforms/login.js",
        "src/platforms/prospect-run.js",
        "src/platforms/comment-targets.js",
        "src/debug-panel.js",
        "src/format.js",
        "src/extract-text.js",
        "src/comments.js",
        "src/rime-context.js",
        "src/content-iso.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "exclude_matches": [
        "*://*.youtube.com/*",
        "*://*.youtu.be/*",
        "*://*.bilibili.com/*",
        "*://*.zhihu.com/*",
        "*://*.xiaohongshu.com/*",
        "*://*.xhslink.com/*",
        "*://*.douyin.com/*"
      ],
      "js": [
        "src/debug-panel.js",
        "src/format.js",
        "src/extract-text.js",
        "src/comments.js",
        "src/rime-context.js",
        "src/content-iso.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
